# Copy to .env and fill in. .env is gitignored.
# Precedence for every setting: CLI flag > real environment > this file > built-in default.

# Source: the Skrooge SQLite file to import (CLI: --input)
SKROOGE_FILE=Skrooge.sqlite

# Destination: your Firefly III instance and a Personal Access Token
# (Firefly III -> Options -> Profile -> OAuth -> Personal Access Tokens).
# CLI overrides: --url / --token
FIREFLY_URL=https://firefly.example.com
FIREFLY_TOKEN=your-personal-access-token-here

# Template Skrooge file for `firefly2skrooge --format sqlite`
# (its schema is copied to build the export; defaults to SKROOGE_FILE).
#SKROOGE_TEMPLATE=Skrooge.sqlite
